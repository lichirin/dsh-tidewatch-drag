/**
 * dsh-tidewatch 浏览器端 bundle（单文件，经 __ModuleLoader__ 加载）。
 *
 * 提供一张「峰谷时刻」悬浮徽章：fixed 悬浮在输入框右侧、与输入框卡片
 * 垂直居中对齐（自研锚定测量，不依赖任何其他插件）；窄窗口放不下时
 * 自动移到输入框上方，绝不遮挡输入框与下方的官方统计栏。视觉为
 * 浮动胶囊风格，与同层其他悬浮组件互不重叠。
 *
 *  - 折叠态：状态点（峰=橙红 / 谷=蓝绿）+ 当前档位 + 距下一阶段倒计时
 *    （2d, 11:50 形式，展开态提供 2d, 11:50:46 秒级精度）+ 本次会话花费（¥，2 位小数）；
 *  - 展开态：官方峰谷时段表（北京时间）、当前档位价格、Token 明细
 *    （输入/缓存/输出/推理）与币种切换。
 *
 * 架构：双组件数据桥——
 *  - Probe（session 作用域插槽 conversation.composer.dock，渲染 null）：
 *    经 useProjection('costUsage') 订阅会话投影，写入模块级 bridge store；
 *  - TideCard（根级插槽 shell.overlay）：订阅 bridge 渲染悬浮徽章。
 *  （root 级插槽无 useProjection 席位，故需桥接。）
 *
 * 计价与显示：账本以美元计价（= 官方人民币标价 ÷ 固定汇率 6.82）；前端再以
 * 同一固定汇率换算人民币显示，默认人民币、2 位小数，人民币数值与官方人民币
 * 标价逐位一致；可切换美元显示、4 位小数。币种选择存 localStorage，仅影响显示。
 * 分模型花费：官方现有两个在售价格的模型（deepseek-flash / deepseek-v4-pro，
 * 后者官方确认 2026-09-14 之后继续提供 API 且计费方式不变），前端按各模型自身
 * 单价、以**当前**峰谷档位重算分模型花费，与徽章总额同档位、不混口径。
 * 样式全部使用 --dsw-* 主题变量，跟随全局亮/暗主题。
 * 峰谷窗口/价格表常量与 lib/pricing.js 保持同步（官方 2026-08-17 峰谷定价；
 * 2026-09-10 起 flash 与 v4-pro 两档并行在售）。
 */

window.__ModuleLoader__.load({
  id: 'dsh-tidewatch-drag',
  factory: (require) => {
    var module = { exports: {} }
    var exports = module.exports
    Object.defineProperty(exports, Symbol.toStringTag, { value: 'Module' })

    const React = require('react')
    const { useState, useEffect, useRef } = React
    const el = React.createElement

    // ── 常量：官方峰谷窗口（UTC 小时，半开区间）与价格表（美元/1M tokens）──

    const PEAK_WINDOWS = [
      { start: 1, end: 4 },
      { start: 6, end: 10 },
    ]

    /**
     * 固定汇率基准：官方人民币标价 ÷ 官方美元标价的隐含汇率。
     * 原官方定价页同时给出 ¥4.50 / $0.66（1M tokens 输出），
     * 4.50 ÷ 0.66 ≈ 6.8181…，取 6.82。
     * 账本以美元计价，人民币展示 = 美元 × FIXED_FX；因此表内美元值由
     * 官方人民币标价 ÷ FIXED_FX 反推，乘回来即与官方人民币标价逐位一致。
     * 必须与 lib/pricing.js 的 CNY_PER_USD 保持同步。
     */
    const FIXED_FX = 6.82
    const CURRENCY_KEY = 'dsh-tidewatch:currency'
    const EXPANDED_KEY = 'dsh-tidewatch:expanded'

    /** 峰谷时代分界（2026-08-16 16:00 UTC）：此前的账目按 legacyBase 计价（与 lib/pricing.js 同步）。 */
    const LEGACY_BASE_BOUNDARY_MS = Date.parse('2026-08-16T16:00:00Z')
    /** 峰谷时代之前的基础价（美元 / 1M tokens，与 lib/pricing.js 的 LEGACY_BASE_USD 同步）。 */
    const LEGACY_BASE = { cacheHit: 0.0028, cacheMiss: 0.14, output: 0.28 }

    /**
     * 展示价格表（人民币 / 1M tokens；数值与官方中文定价页逐位一致，
     * 与 lib/pricing.js 的 rates.cny 同源），美元值由 ÷ FIXED_FX 反推。
     *
     * 官方现有两个在售价格的模型：
     *   - `deepseek-flash`（V4.1-Flash）：谷时 ¥0.02 / ¥1 / ¥4；
     *   - `deepseek-v4-pro`（V4-Pro-0813）：谷时 ¥0.15 / ¥4.5 / ¥13.5（峰时 ×2）。
     * 旧 Flash 名（deepseek-v4-flash、deepseek-v4-flash-vision-exp）官方按 flash 价计费。
     */
    const RATE_RULES = [
      {
        key: 'flash',
        label: 'deepseek-flash',
        cny: {
          offPeak: { cacheHit: 0.02, cacheMiss: 1, output: 4 },
          peak: { cacheHit: 0.04, cacheMiss: 2, output: 8 },
        },
        models: ['deepseekflash', 'deepseekv41flash', 'deepseekv4flash', 'deepseekv4flashvisionexp'],
      },
      {
        key: 'pro',
        label: 'deepseek-v4-pro',
        cny: {
          offPeak: { cacheHit: 0.15, cacheMiss: 4.5, output: 13.5 },
          peak: { cacheHit: 0.3, cacheMiss: 9, output: 27 },
        },
        models: ['deepseekv4pro', 'deepseekpro'],
      },
    ]

    /** 兜底规则（未知模型名按 flash 价估算，与 lib/pricing.js 的 FALLBACK_PRICE_RULE 同步）。 */
    const RATE_RULE_FALLBACK = 'flash'

    /** 展示价格表：规则键 → { key, label, offPeak, peak }（美元 / 1M tokens）。 */
    const DISPLAY_PRICES = {}
    for (const rule of RATE_RULES) {
      const toUsd = t => ({ cacheHit: t.cacheHit / FIXED_FX, cacheMiss: t.cacheMiss / FIXED_FX, output: t.output / FIXED_FX })
      DISPLAY_PRICES[rule.key] = {
        key: rule.key,
        label: rule.label,
        offPeak: toUsd(rule.cny.offPeak),
        peak: toUsd(rule.cny.peak),
      }
    }

    // 北京时间时段表（北京 = UTC+8，无夏令时）。官方 2026-08-23 起：
    // 周六/周日（UTC 自然日）全天按谷期计价，无峰谷切换。
    const BEIJING_SLOTS = [
      { start: '09:00', end: '12:00', phase: 'peak', text: '峰' },
      { start: '12:00', end: '14:00', phase: 'offpeak', text: '谷' },
      { start: '14:00', end: '18:00', phase: 'peak', text: '峰' },
      { start: '18:00', end: '次日 09:00', phase: 'offpeak', text: '谷' },
    ]
    /** 周末（UTC 周六/周日）判定：全天谷期，无阶段切换。 */
    function isWeekendUTC(atMs) {
      const day = new Date(atMs).getUTCDay()
      return day === 0 || day === 6
    }

    // ── 数据桥：会话投影 → 悬浮层（root 插槽无 useProjection 席位）──────────

    const bridge = {
      value: null,
      listeners: new Set(),
      set(value) {
        this.value = value
        for (const fn of [...this.listeners]) fn(value)
      },
      subscribe(fn) {
        this.listeners.add(fn)
        return () => { this.listeners.delete(fn) }
      },
    }

    // ── 纯函数：峰谷判定 / 倒计时 / 格式化 ──────────────────────────────────

    function isPeakHourUTC(atMs) {
      if (isWeekendUTC(atMs)) return false // 周末全天谷期
      const hour = new Date(atMs).getUTCHours()
      return PEAK_WINDOWS.some(w => hour >= w.start && hour < w.end)
    }

    /** 当前相位与下一次切换点（UTC）。周末无切换点，下一时刻为下周一首次进入峰时。 */
    function nextPhase(atMs) {
      const hourAt = (dayOffset, hour) => {
        const d = new Date(atMs)
        d.setUTCDate(d.getUTCDate() + dayOffset)
        d.setUTCHours(hour, 0, 0, 0)
        return d.getTime()
      }
      const points = []
      // 收集前三天到后三天：覆盖周六/周日 → 下周一峰时的跨度
      // （周日晚/周一凌晨的 prev 落在上周五 10:00，故必须看到 -3 天）。
      for (let day = -3; day <= 3; day += 1) {
        const dow = new Date(hourAt(day, 0)).getUTCDay()
        if (dow === 0 || dow === 6) continue // 周末无峰谷切换
        for (const w of PEAK_WINDOWS) {
          points.push({ at: hourAt(day, w.start), intoPeak: true })
          points.push({ at: hourAt(w.end <= w.start ? day + 1 : day, w.end), intoPeak: false })
        }
      }
      const inPeak = isPeakHourUTC(atMs)
      let prev = null
      let next = null
      for (const p of points) {
        if (p.at <= atMs && (prev === null || p.at > prev.at)) prev = p
        if (p.at > atMs && (next === null || next.at < next.at)) next = p
      }
      if (prev === null || next === null) return null
      return { inPeak, nextAtMs: next.at, nextIntoPeak: next.intoPeak }
    }

    /** 展开态倒计时：日 + 时:分:秒（如 2d, 11:50:46；满一天才带 "Nd, " 前缀）。 */
    function fmtCountdown(ms) {
      const total = Math.max(0, Math.floor(ms / 1000))
      const d = Math.floor(total / 86400)
      const h = Math.floor((total % 86400) / 3600)
      const m = Math.floor((total % 3600) / 60)
      const s = total % 60
      const p = n => String(n).padStart(2, '0')
      return (d > 0 ? d + 'd, ' : '') + p(h) + ':' + p(m) + ':' + p(s)
    }

    /** 折叠态倒计时：日 + 时:分（如 2d, 11:50；满一天才带 "Nd, " 前缀）。 */
    /** 按分钟向上取整，避免每秒闪动；秒级精度在展开态提供。 */
    function fmtCountdownShort(ms) {
      const totalMin = Math.max(0, Math.ceil(ms / 60000))
      const d = Math.floor(totalMin / 1440)
      const h = Math.floor((totalMin % 1440) / 60)
      const m = totalMin % 60
      const p = n => String(n).padStart(2, '0')
      return (d > 0 ? d + 'd, ' : '') + p(h) + ':' + p(m)
    }

    /** 金额显示：人民币 2 位小数（× 固定汇率），美元 4 位小数（原始值）。 */
    function fmtMoney(usd, currency) {
      return currency === 'usd' ? '$' + usd.toFixed(4) : '¥' + (usd * FIXED_FX).toFixed(2)
    }

    function fmtTokens(n) {
      n = Math.max(0, Math.round(Number(n) || 0))
      if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M'
      if (n >= 1e4) return (n / 1e3).toFixed(1) + 'K'
      if (n >= 1e3) return (n / 1e3).toFixed(2) + 'K'
      return String(n)
    }

    /**
     * 模型名归一化匹配（与 lib/pricing.js 的 priceRuleFor 一致）。
     * 匹配顺序：归一化精确命中 → 规则键最长包含命中 → 兜底 flash。
     * @param model - 请求头里的模型名。
     * @returns 价格规则键（'flash' / 'pro'）。
     */
    function priceRuleKeyFor(model) {
      const normalize = s => String(s ?? '').toLowerCase().replace(/[\s\-_.()（）]/g, '')
      const id = normalize(model)
      if (id.length === 0) return RATE_RULE_FALLBACK
      let best = null
      for (const rule of RATE_RULES) {
        if (rule.models.includes(id)) return rule.key
        for (const alias of rule.models) {
          if (id.includes(alias) && (best === null || alias.length > best.length)) best = { key: rule.key, length: alias.length }
        }
      }
      return best !== null ? best.key : RATE_RULE_FALLBACK
    }

    /**
     * 某模型在给定时刻的峰谷两档单价（美元 / 1M tokens）。
     * 与宿主 lib/pricing.js 的 tierFor 逻辑一致：峰谷时代前用 legacyBase。
     * @param model - 模型名。
     * @param atMs - 计费时刻。
     * @param inPeak - 当前是否峰期（徽章已算好的相位）。
     * @returns { cacheHit, cacheMiss, output }。
     */
    function tierForModel(model, atMs, inPeak) {
      if (Number.isFinite(atMs) && atMs < LEGACY_BASE_BOUNDARY_MS) return LEGACY_BASE
      const price = DISPLAY_PRICES[priceRuleKeyFor(model)]
      return inPeak ? price.peak : price.offPeak
    }

    /** 一次调用的美元成本（与 lib/pricing.js 的 costOf 同口径）。 */
    function costOfBuckets(bucket, tier) {
      const input = Math.max(0, Number(bucket?.input) || 0)
      const output = Math.max(0, Number(bucket?.output) || 0)
      const cacheRead = Math.max(0, Number(bucket?.cacheRead) || 0)
      const cacheWrite = Math.max(0, Number(bucket?.cacheWrite) || 0)
      return (input * tier.cacheMiss + output * tier.output + (cacheRead + cacheWrite) * tier.cacheHit) / 1e6
    }

    /** 北京时间时段表行号；周末返 -1（周末全天谷期，无时段行可高亮）。 */
    function beijingSlotIndex(atMs) {
      if (isWeekendUTC(atMs)) return -1
      const h = (new Date(atMs).getUTCHours() + 8) % 24
      if (h >= 9 && h < 12) return 0
      if (h >= 12 && h < 14) return 1
      if (h >= 14 && h < 18) return 2
      return 3
    }

    function loadCurrency() {
      try {
        const v = localStorage.getItem(CURRENCY_KEY)
        if (v === 'usd' || v === 'cny') return v
      } catch { /* ignore */ }
      return 'cny'
    }

    // ── 样式（--dsw-* 主题变量，跟随亮/暗主题）─────────────────────────────

    const CSS_TAG_ID = 'dsh-tidewatch-drag'
    const css = [
      '/* dsh-tidewatch: 峰谷时刻悬浮徽章 */',
      '.tw-root{position:fixed;z-index:1001;pointer-events:auto}',
      '.tw-chip{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 11px;border-radius:999px;border:1px solid var(--dsw-alias-border-l2-darkmode-thin,var(--dsw-alias-border-l1,#444));background:var(--dsw-alias-button-floating-fill,var(--dsw-alias-bg-layer-2,#222));color:var(--dsw-alias-label-secondary,#8b8b8b);font-size:11px;line-height:24px;white-space:nowrap;cursor:pointer;user-select:none;box-shadow:var(--dsw-shadow-lv2,0 4px 12px rgba(0,0,0,.2));transition:background .15s ease,border-color .15s ease}',
      '.tw-chip:hover{background:var(--dsw-alias-button-floating-hover,var(--dsw-alias-bg-layer-2,#222));border-color:var(--dsw-alias-border-l3,#666)}',
      '.tw-chip{cursor:grab}',
      '.tw-chip:active,.tw-chip.tw-dragging{cursor:grabbing}',
      '.tw-chip.tw-dragging{opacity:.92}',
      '.tw-dot{flex:none;width:9px;height:9px;border-radius:50%;box-shadow:0 0 0 4px color-mix(in srgb,currentColor 18%,transparent)}',
      '.tw-chip.peak .tw-dot{background:var(--dsw-alias-state-warn-primary,#f59e0b);color:var(--dsw-alias-state-warn-primary,#f59e0b)}',
      '.tw-chip.offpeak .tw-dot{background:var(--dsw-alias-state-success-primary,#10b981);color:var(--dsw-alias-state-success-primary,#10b981)}',
      '.tw-phase{font-weight:600;font-variant-numeric:tabular-nums}',
      '.tw-chip.peak .tw-phase{color:var(--dsw-alias-state-warn-primary,#f59e0b)}',
      '.tw-chip.offpeak .tw-phase{color:var(--dsw-alias-state-success-primary,#10b981)}',
      '.tw-countdown{font-variant-numeric:tabular-nums}',
      '.tw-sep{flex:none;width:1px;height:12px;background:var(--dsw-alias-border-l1,#444)}',
      '.tw-cost{font-weight:600;color:var(--dsw-alias-label-primary,#e8e8e8);font-variant-numeric:tabular-nums}',
      '.tw-panel.tw-panel-left .tw-panel-tools{flex-direction:row-reverse}',
      // 面板用 fixed 定位：坐标由 placePanel 按视口算好，不受祖先 transform /
      // overflow 影响（徽章若被祖先元素裁剪也不会切掉面板）。
      '.tw-panel{position:fixed;z-index:1002;box-sizing:border-box;padding:12px 14px;border-radius:14px;border:1px solid var(--dsw-alias-border-l2,var(--dsw-alias-border-l1,#444));background:var(--dsw-alias-bg-overlay,var(--dsw-alias-bg-layer-2,#1f1f1f));box-shadow:var(--dsw-shadow-lv2,0 14px 36px rgba(0,0,0,.24));font-size:12px;color:var(--dsw-alias-label-primary,#e8e8e8);text-align:left;white-space:normal}',
      // 自适应高度：内容超出（自然高度 > maxHeight）时内部滚动。
      '.tw-panel.tw-panel-fit{overflow:auto;scrollbar-width:thin}',
      '.tw-panel.tw-panel-custom{overflow:auto;resize:none;scrollbar-width:thin}',
      '.tw-panel.tw-panel-fit::-webkit-scrollbar,.tw-panel.tw-panel-custom::-webkit-scrollbar{width:8px;height:8px}',
      '.tw-panel.tw-panel-fit::-webkit-scrollbar-thumb,.tw-panel.tw-panel-custom::-webkit-scrollbar-thumb{background:var(--dsw-alias-border-l2,var(--dsw-alias-border-l1,#444));border-radius:4px}',
      '.tw-panel.tw-panel-fit::-webkit-scrollbar-track,.tw-panel.tw-panel-custom::-webkit-scrollbar-track{background:transparent}',
      '.tw-panel-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}',
      // 拖动手柄：整个面板头部都可拖动移动面板（抓手光标提示）。
      '.tw-panel.tw-panel-custom .tw-panel-head{cursor:grab;user-select:none}',
      '.tw-panel.tw-panel-custom .tw-panel-head.tw-panel-dragging{cursor:grabbing}',
      '.tw-panel-tools{display:inline-flex;align-items:center;gap:6px}',
      '.tw-panel-reset{font:inherit;font-size:11px;line-height:18px;padding:0 8px;border-radius:6px;cursor:pointer;color:var(--dsw-alias-label-tertiary,#9b9b9b);background:var(--dsw-alias-bg-layer-1,transparent);border:1px solid var(--dsw-alias-border-l1,#444)}',
      '.tw-panel-reset:hover{color:var(--dsw-alias-label-primary,#e8e8e8);background:var(--dsw-alias-interactive-bg-hover,rgba(127,127,127,.1))}',
      // 缩放手柄：常驻可见的小按钮 + 两段对角斜线（原生 resize 三角在暗色主题下
      // 几乎不可见，因此自绘）。用 label-secondary 提升对比度，避免「看不见抓手」。
      '.tw-grip{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:6px;flex:none;cursor:pointer;color:var(--dsw-alias-label-secondary,#b8b8b8);background:var(--dsw-alias-bg-layer-2,rgba(127,127,127,.12));border:1px solid var(--dsw-alias-border-l1,#444);transition:color .15s ease,background .15s ease,border-color .15s ease}',
      '.tw-grip:hover{color:var(--dsw-alias-label-primary,#f0f0f0);background:var(--dsw-alias-interactive-bg-hover,rgba(127,127,127,.22));border-color:var(--dsw-alias-border-l2,#666)}',
      '.tw-grip.tw-grip-active{color:var(--dsw-alias-label-primary,#f0f0f0);background:var(--dsw-alias-interactive-bg-hover,rgba(127,127,127,.28));border-color:var(--dsw-alias-state-business-primary,#4d9fff)}',
      // 抓手在「贴徽章的那条竖边」的底角：右开面板贴徽章左缘 → 抓手在右下角；
      // 左开面板贴徽章右缘 → 抓手在左下角。光标与所在角一致。
      '.tw-grip.tw-grip-nw{cursor:nwse-resize}',
      '.tw-grip.tw-grip-ne{cursor:nesw-resize}',
      // 面板向上弹出时成长边在顶部：抓手图标翻到上一行斜线，与拖动方向一致。
      '.tw-grip-down svg{transform:scale(1,1)}',
      '.tw-grip-up svg{transform:scale(1,-1)}',
      '.tw-grip-spacer{flex:1 1 auto}',
      '.tw-currency{gap:5px;flex-wrap:wrap;row-gap:4px}',
      '.tw-currency-btn{padding:1px 8px}',
      '.tw-panel-phase{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:700}',
      '.tw-panel-phase .tw-dot{width:10px;height:10px}',
      '.tw-panel-phase.peak{color:var(--dsw-alias-state-warn-primary,#f59e0b)}',
      '.tw-panel-phase.offpeak{color:var(--dsw-alias-state-success-primary,#10b981)}',
      '.tw-panel-countdown{font-size:12px;color:var(--dsw-alias-label-tertiary,#9b9b9b);font-variant-numeric:tabular-nums}',
      '.tw-h{font-size:11px;font-weight:600;letter-spacing:.3px;color:var(--dsw-alias-label-tertiary,#9b9b9b);margin:10px 0 6px}',
      '.tw-h:first-of-type{margin-top:0}',
      '.tw-slots{display:flex;flex-direction:column;gap:3px}',
      '.tw-slot{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:3px 8px;border-radius:7px;font-variant-numeric:tabular-nums}',
      '.tw-slot.now{background:var(--dsw-alias-interactive-bg-hover,rgba(127,127,127,.1))}',
      '.tw-slot .tw-slot-time{color:var(--dsw-alias-label-secondary,#c5c5c5)}',
      '.tw-slot .tw-slot-tag{flex:none;min-width:30px;text-align:center;font-weight:600;border-radius:999px;padding:0 8px;font-size:11px;line-height:18px}',
      '.tw-slot .tw-slot-tag.peak{color:var(--dsw-alias-state-warn-primary,#f59e0b);background:color-mix(in srgb,var(--dsw-alias-state-warn-primary,#f59e0b) 14%,transparent)}',
      '.tw-slot .tw-slot-tag.offpeak{color:var(--dsw-alias-state-success-primary,#10b981);background:color-mix(in srgb,var(--dsw-alias-state-success-primary,#10b981) 14%,transparent)}',
      '.tw-slot-now-tip{margin-left:6px;font-size:11px;color:var(--dsw-alias-label-tertiary,#9b9b9b)}',
      '.tw-prices{display:flex;flex-direction:column;gap:3px;font-variant-numeric:tabular-nums}',
      '.tw-price-row{display:flex;justify-content:space-between;gap:8px;padding:3px 8px}',
      '.tw-price-row .tw-price-label{color:var(--dsw-alias-label-secondary,#c5c5c5);display:inline-flex;align-items:center;gap:6px}',
      '.tw-price-now{flex:none;font-size:10px;line-height:16px;padding:0 6px;border-radius:999px;color:var(--dsw-alias-state-success-primary,#10b981);background:color-mix(in srgb,var(--dsw-alias-state-success-primary,#10b981) 14%,transparent)}',
      '.tw-price-row .tw-price-val{color:var(--dsw-alias-label-primary,#e8e8e8);font-weight:600}',
      '.tw-tokens{display:grid;grid-template-columns:1fr 1fr;gap:3px 12px;font-variant-numeric:tabular-nums}',
      '.tw-token-row{display:flex;justify-content:space-between;gap:8px;padding:3px 8px}',
      '.tw-token-row .tw-token-label{color:var(--dsw-alias-label-secondary,#c5c5c5)}',
      '.tw-token-row .tw-token-val{color:var(--dsw-alias-label-primary,#e8e8e8);font-weight:600}',
      '.tw-total{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px;padding:8px 10px;border-radius:10px;background:var(--dsw-alias-bg-layer-1,transparent);border:1px solid var(--dsw-alias-border-l1,#444);cursor:pointer;user-select:none;transition:background .15s ease}',
      '.tw-total:hover{background:var(--dsw-alias-interactive-bg-hover,rgba(127,127,127,.1))}',
      '.tw-total-label{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--dsw-alias-label-secondary,#c5c5c5)}',
      '.tw-total-arrow{flex:none;font-size:9px;color:var(--dsw-alias-label-tertiary,#9b9b9b);transition:transform .15s ease}',
      '.tw-total.open .tw-total-arrow{transform:rotate(90deg)}',
      '.tw-total-val{font-size:16px;font-weight:700;color:var(--dsw-alias-label-primary,#e8e8e8);font-variant-numeric:tabular-nums}',
      '.tw-models{margin-top:6px;padding:4px 10px 2px;display:flex;flex-direction:column;gap:2px}',
      '.tw-model-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:3px 0;font-size:12px}',
      '.tw-model-row + .tw-model-row{border-top:1px solid var(--dsw-alias-border-l1,#444)}',
      '.tw-model-label{color:var(--dsw-alias-label-secondary,#c5c5c5);display:inline-flex;align-items:center;gap:6px}',
      '.tw-model-tag{flex:none;font-size:10px;line-height:16px;padding:0 6px;border-radius:999px;color:var(--dsw-alias-label-tertiary,#9b9b9b);background:var(--dsw-alias-bg-layer-2,transparent);border:1px solid var(--dsw-alias-border-l1,#444)}',
      '.tw-model-val{font-weight:600;color:var(--dsw-alias-label-primary,#e8e8e8);font-variant-numeric:tabular-nums}',
      '.tw-currency{display:flex;align-items:center;gap:6px;margin-top:8px;padding:0 2px;font-size:11px;color:var(--dsw-alias-label-tertiary,#9b9b9b)}',
      '.tw-currency-btn{font:inherit;font-size:11px;color:var(--dsw-alias-label-secondary,#c5c5c5);background:var(--dsw-alias-bg-layer-1,transparent);border:1px solid var(--dsw-alias-border-l1,#444);border-radius:6px;padding:1px 10px;cursor:pointer;line-height:18px}',
      '.tw-currency-btn:hover{background:var(--dsw-alias-interactive-bg-hover,rgba(127,127,127,.1))}',
      '.tw-currency-btn.on{color:var(--dsw-alias-label-primary,#e8e8e8);border-color:var(--dsw-alias-state-business-primary,#4d9fff)}',
      '.tw-empty-note{padding:3px 8px;color:var(--dsw-alias-label-tertiary,#9b9b9b)}',
    ].join('\n')

    if (typeof document !== 'undefined' && document.querySelector('style[data-plugin-css=' + JSON.stringify(CSS_TAG_ID) + ']') === null) {
      const tag = document.createElement('style')
      tag.setAttribute('data-plugin-css', CSS_TAG_ID)
      tag.textContent = css
      document.head.appendChild(tag)
    }

    // ── 悬浮定位：锚定输入框右侧、与卡片垂直居中；放不下移到输入框上方 ──────
    // 拖拽改造（本地 fork）：徽章可自由拖动，位置写入 localStorage 并在刷新后
    // 保留；拖动过之后自动贴靠测量不再覆盖用户位置，点「复位」回到自动位置。

    const POS_KEY = 'dsh-tidewatch-position-v1'
    // 拖动/夹紧时徽章与视口四边的最小间距：保证徽章整体留在窗口内。
    const DRAG_EDGE = 4
    const DRAG_SLOP = 4

    // ── 展开面板的尺寸与位移（本地 fork 追加：面板可拖动 + 右下角缩放）──────
    const PANEL_GEOM_KEY = 'dsh-tidewatch-panel-v1'
    /** 面板默认尺寸与缩放上下限（px）。 */
    const PANEL_DEFAULT_W = 320
    const PANEL_DEFAULT_H = 430
    const PANEL_MIN_W = 240
    const PANEL_MIN_H = 180
    const PANEL_MAX_W = 900
    const PANEL_MAX_H = 1200
    /** 面板与视口四边的最小间距（拖动/缩放时夹紧，保证抓手始终可点）。 */
    const PANEL_EDGE = 8

    /** 读取面板自定义尺寸/位移；无记录或非法值返回 null（= 回到默认尺寸与紧贴徽章的位置）。 */
    function loadPanelGeom() {
      try {
        const raw = localStorage.getItem(PANEL_GEOM_KEY)
        if (raw === null) return null
        const v = JSON.parse(raw)
        if (typeof v !== 'object' || v === null) return null
        const num = key => (Number.isFinite(Number(v[key])) ? Number(v[key]) : null)
        const geom = { width: num('width'), height: num('height'), offsetX: num('offsetX'), offsetY: num('offsetY') }
        if (geom.width === null && geom.height === null && geom.offsetX === null && geom.offsetY === null) return null
        return geom
      } catch { return null }
    }

    function savePanelGeom(geom) {
      try { localStorage.setItem(PANEL_GEOM_KEY, JSON.stringify(geom)) } catch { /* ignore */ }
    }

    function clearPanelGeom() {
      try { localStorage.removeItem(PANEL_GEOM_KEY) } catch { /* ignore */ }
    }

    function clamp(v, lo, hi) {
      return Math.min(Math.max(v, lo), hi)
    }

    /** 数值上下限夹紧；lo 大于 hi 时（面板比可视区还大）取 lo，保证内容起点可见。 */
    function clampRange(v, lo, hi) {
      return Math.max(lo, Math.min(v, hi))
    }

    /**
     * 缩放夹紧：保证面板不超出视口，并受上下限约束。
     * @param width - 期望宽度。
     * @param height - 期望高度。
     * @param viewportW / viewportH - 视口尺寸（缺省取实时值，便于测试注入）。
     */
    function clampPanelSize(width, height, viewportW, viewportH) {
      const vw = viewportW ?? window.innerWidth
      const vh = viewportH ?? window.innerHeight
      const maxW = Math.min(PANEL_MAX_W, Math.max(PANEL_MIN_W, vw - PANEL_EDGE * 2))
      const maxH = Math.min(PANEL_MAX_H, Math.max(PANEL_MIN_H, vh - PANEL_EDGE * 2))
      return {
        width: clampRange(width, PANEL_MIN_W, maxW),
        height: clampRange(height, PANEL_MIN_H, maxH),
      }
    }

    /**
     * 按「自动弹出位置」与期望尺寸，算出把面板夹回视口后应记录的位移。
     * 位移是相对自动位置的增量，因此夹紧必须基于 base（而不是已经夹过的当前位置），
     * 否则面板贴边后再往同方向拖就会「拖不动」。
     * @param base - 位移为 0 时的面板盒子（placePanel 的产物）。
     * @param offset - 待夹紧的 { x, y } 位移。
     * @param size - 待夹紧的 { width, height }。
     * @returns 夹紧后的位移。
     */
    function clampPanelOffsetWithin(base, offset, size) {
      const w = Math.max(0, Number(size?.width) || 0)
      const h = Math.max(0, Number(size?.height) || 0)
      const baseLeft = Number.isFinite(base?.left) ? base.left : PANEL_EDGE
      const baseTop = Number.isFinite(base?.top) ? base.top : PANEL_EDGE
      const left = baseLeft + (Number(offset?.x) || 0)
      const top = baseTop + (Number(offset?.y) || 0)
      // 夹紧的是「最终左/上坐标」，再换算回位移——面板大于可视区时取边距，不来回跳。
      const maxLeft = Math.max(PANEL_EDGE, window.innerWidth - PANEL_EDGE - w)
      const maxTop = Math.max(PANEL_EDGE, window.innerHeight - PANEL_EDGE - h)
      return {
        x: clampRange(left, PANEL_EDGE, maxLeft) - baseLeft,
        y: clampRange(top, PANEL_EDGE, maxTop) - baseTop,
      }
    }

    /**
     * 把目标矩形夹进视口（边距 PANEL_EDGE），夹紧的是**左上坐标**：
     * 面板比可视区大时取边距，避免来回跳。
     * @param left / top - 目标左上坐标。
     * @param size - 目标 { width, height }。
     * @returns 夹紧后的 { left, top }。
     */
    function clampBoxToViewport(left, top, size, viewportW, viewportH) {
      const w = Math.max(0, Number(size?.width) || 0)
      const h = Math.max(0, Number(size?.height) || 0)
      const vw = viewportW ?? window.innerWidth
      const vh = viewportH ?? window.innerHeight
      return {
        left: clampRange(left, PANEL_EDGE, Math.max(PANEL_EDGE, vw - PANEL_EDGE - w)),
        top: clampRange(top, PANEL_EDGE, Math.max(PANEL_EDGE, vh - PANEL_EDGE - h)),
      }
    }

    /** 徽章与面板之间的间距（面板放在徽章上方 / 下方时留出的空隙）。 */
    const PANEL_ANCHOR_GAP = 10

    /**
     * 计算面板最终盒子：自适应弹出方向 + 尺寸夹紧 + 用户位移。
     *
     * 方向按**可用空间**选：宽度优先放在徽章右侧（右边缘超出视口则翻到左侧），
     * 高度优先放在徽章上方（上方装不下则翻到下方）。因此即使输入框被顶到视口
     * 顶端（长会话向下滚动后很常见），面板也不会跑到屏幕外——这是 v1.1.1 的
     * 「面板跑到可视范围外」根因。
     *
     * 这个计算与徽章位置无关地独立运行：面板用 fixed 定位，只要这里有正确的
     * 坐标就不会被任何祖先的 transform / overflow 裁掉。
     *
     * @param input - { chip, naturalWidth, naturalHeight, saved, below, viewportW?, viewportH? }。
     * @returns 最终盒子 { left, top, width, maxHeight, dirX, dirY }。
     */
    function computePanelBox(input) {
      const chip = input.chip
      const viewportW = input.viewportW ?? window.innerWidth
      const viewportH = input.viewportH ?? window.innerHeight
      const saved = input.saved ?? {}
      const savedW = Number.isFinite(saved.width) ? saved.width : null
      const savedH = Number.isFinite(saved.height) ? saved.height : null
      const offsetX = Number.isFinite(saved.offsetX) ? saved.offsetX : 0
      const offsetY = Number.isFinite(saved.offsetY) ? saved.offsetY : 0
      const naturalW = Number.isFinite(input.naturalWidth) && input.naturalWidth > 0 ? input.naturalWidth : PANEL_DEFAULT_W
      const naturalH = Number.isFinite(input.naturalHeight) && input.naturalHeight > 0 ? input.naturalHeight : PANEL_DEFAULT_H
      const wantedW = savedW ?? naturalW
      const wantedH = savedH ?? naturalH
      const maxW = Math.max(PANEL_MIN_W, viewportW - PANEL_EDGE * 2)

      // 横向：优先在徽章右侧展开（徽章悬在输入框右外侧），右侧不够则翻到左侧。
      const spaceRight = viewportW - PANEL_EDGE - (chip.right + PANEL_ANCHOR_GAP)
      const spaceLeft = (chip.left - PANEL_ANCHOR_GAP) - PANEL_EDGE
      const dirRight = spaceRight >= Math.min(wantedW, maxW) || spaceRight >= spaceLeft

      // 纵向：默认向上（面板不压输入框），只有「上方连最低高度都放不下」时才翻到下方。
      // 用固定门槛（PANEL_MIN_H）判定，不依赖实测高度，避免「翻上去→装满→又翻下来」抖动；
      // 上方空间不足时 maxHeight 会把它压到可用范围，因此面板永远不会顶出屏幕。
      let spaceAbove = Math.max(0, Math.floor(chip.top - PANEL_ANCHOR_GAP - PANEL_EDGE))
      let spaceBelow = Math.max(0, Math.floor(viewportH - PANEL_EDGE - (chip.bottom + PANEL_ANCHOR_GAP)))
      let dirBelow = input.below === true || (spaceAbove < PANEL_MIN_H && spaceBelow > spaceAbove)
      const spaceY = dirBelow ? spaceBelow : spaceAbove
      if (spaceY <= 0) {
        // 徽章贴在视口某一侧：退化为「占用剩余空间最多的一侧」，并允许贴边。
        dirBelow = spaceBelow >= spaceAbove
        spaceAbove = Math.max(spaceAbove, PANEL_MIN_H)
        spaceBelow = Math.max(spaceBelow, PANEL_MIN_H)
      }

      const width = clampRange(
        wantedW,
        PANEL_MIN_W,
        Math.max(PANEL_MIN_W, Math.min(maxW, Math.max(spaceRight, spaceLeft))),
      )
      // 高度：未自定义高度时保持自适应，maxHeight 只作为上限（避免面板顶出屏幕）；
      // 用户自定义高度则把该高度夹进可用空间。
      const maxHeight = savedH !== null
        ? clampRange(wantedH, PANEL_MIN_H, Math.min(PANEL_MAX_H, Math.max(PANEL_MIN_H, dirBelow ? spaceBelow : spaceAbove)))
        : Math.min(PANEL_MAX_H, Math.max(PANEL_MIN_H, dirBelow ? spaceBelow : spaceAbove))

      const anchorLeft = dirRight ? chip.left : chip.right - width
      const anchorTop = dirBelow ? chip.bottom + PANEL_ANCHOR_GAP : chip.top - PANEL_ANCHOR_GAP - maxHeight

      // 用户拖动位移：以自适应位置为基准做增量，并整体夹回视口内。
      const left = clampRange(anchorLeft + offsetX, PANEL_EDGE, Math.max(PANEL_EDGE, viewportW - PANEL_EDGE - width))
      const top = clampRange(anchorTop + offsetY, PANEL_EDGE, Math.max(PANEL_EDGE, viewportH - PANEL_EDGE - maxHeight))
      return { left, top, width, maxHeight, dirX: dirRight ? 'right' : 'left', dirY: dirBelow ? 'below' : 'above' }
    }

    /**
     * 读取当前视口尺寸，调用 computePanelBox。
     * @param input - 同 computePanelBox（不含视口尺寸）。
     * @returns 面板盒子。
     */
    function placePanel(input) {
      return computePanelBox({ viewportW: window.innerWidth, viewportH: window.innerHeight, ...input })
    }

    function loadCustomPos() {
      try {
        const raw = localStorage.getItem(POS_KEY)
        if (raw === null) return null
        const v = JSON.parse(raw)
        if (typeof v !== 'object' || v === null) return null
        const right = Number(v.right)
        const bottom = Number(v.bottom)
        if (!Number.isFinite(right) || !Number.isFinite(bottom)) return null
        return { right, bottom }
      } catch { return null }
    }

    function saveCustomPos(p) {
      try { localStorage.setItem(POS_KEY, JSON.stringify(p)) } catch { /* ignore */ }
    }

    function clearCustomPos() {
      try { localStorage.removeItem(POS_KEY) } catch { /* ignore */ }
    }

    function clampPos(p, rootEl) {
      const w = rootEl !== null ? rootEl.offsetWidth : 200
      const h = rootEl !== null ? rootEl.offsetHeight : 24
      const maxRight = Math.max(DRAG_EDGE, window.innerWidth - w - DRAG_EDGE)
      const maxBottom = Math.max(DRAG_EDGE, window.innerHeight - h - DRAG_EDGE)
      return {
        right: Math.min(Math.max(p.right, DRAG_EDGE), maxRight),
        bottom: Math.min(Math.max(p.bottom, DRAG_EDGE), maxBottom),
      }
    }

    /**
     * 徽章定位 + 面板定位的测量。
     *
     * 面板的自动位置**只在渲染期**由 placePanel 算出（直接读徽章实时矩形），
     * 不经过 state 中转——徽章矩形本身就是渲染结果的一部分，用 state 传递会出现
     * 「测量早于渲染 → 位置过期」的时序问题（此前拖动被误夹紧的根因）。
     * 这里只用 measureSeq 触发首帧之后的那一次补渲染（首帧 rootRef 还未挂上，
     * 测不出徽章矩形）。
     */
    function usePlacement(rootRef, draggingRef) {
      const [pos, setPos] = useState(() => loadCustomPos() ?? { right: 16, bottom: 96 })
      const [measureSeq, setMeasureSeq] = useState(0)
      useEffect(() => {
        let raf = 0
        function setPosIfChanged(next) {
          setPos(prev => (prev.right === next.right && prev.bottom === next.bottom ? prev : next))
        }
        /** 按徽章卡片位置计算徽章坐标（右侧优先，否则移到卡片上方）。 */
        function chipPos(cardEl, W, H) {
          const GAP = 12
          const EDGE = 16
          if (!cardEl) return { right: EDGE, bottom: 96 }
          const r = cardEl.getBoundingClientRect()
          // 徽章左缘 = 卡片右缘 + GAP，即 right 必须同时减去 GAP 与徽章宽度 W：
          // 只对齐右缘会让宽 200px 的徽章向左展开、侵入输入框卡片内部
          // （此前「全屏下挡输入框区域」的根因）。
          const right = window.innerWidth - r.right - GAP - W
          // 徽章与输入框卡片垂直居中对齐：卡片中心高度就是徽章中心高度。
          const centerY = r.top + r.height / 2
          const verticalOK = H <= r.height + 1
            && centerY - H / 2 >= EDGE
            && centerY + H / 2 <= window.innerHeight - EDGE
          if (right >= EDGE && verticalOK) {
            return { right, bottom: window.innerHeight - centerY - H / 2 }
          }
          // 放不下：移到输入框上方、贴视口右缘——不与同层其他悬浮组件的常见
          // 兜底位置（视口左侧）重叠，也不遮挡输入框。
          return { right: EDGE, bottom: Math.max(EDGE, window.innerHeight - r.top + GAP) }
        }
        function measure() {
          cancelAnimationFrame(raf)
          raf = requestAnimationFrame(() => {
            const card = document.querySelector('[data-composer-card]')
            const W = rootRef.current !== null ? rootRef.current.offsetWidth : 200
            const H = rootRef.current !== null ? rootRef.current.offsetHeight : 24
            // 用户拖过 / 正在拖动：不覆盖自定义位置，只做视口内夹紧。
            if (draggingRef.current || loadCustomPos() !== null) {
              setPos(prev => clampPos(prev, rootRef.current))
            } else {
              setPosIfChanged(chipPos(card, W, H))
            }
            // 徽章矩形是面板定位的输入：测量完触发一次渲染，让面板按新位置重算。
            setMeasureSeq(n => n + 1)
          })
        }
        measure()
        window.addEventListener('resize', measure)
        const ro = new ResizeObserver(measure)
        const overlayEl = document.querySelector('[data-shell-overlay]')
        const frameEl = overlayEl && overlayEl.parentElement
        if (frameEl && frameEl.firstElementChild) ro.observe(frameEl.firstElementChild)
        const mo = new MutationObserver(measure)
        mo.observe(document.body, { childList: true, subtree: true })
        return () => {
          cancelAnimationFrame(raf)
          window.removeEventListener('resize', measure)
          ro.disconnect()
          mo.disconnect()
        }
      }, [])
      return { pos, measureSeq }
    }

    // ── 数据探针（session 插槽）：订阅投影写入 bridge，渲染 null ────────────

    function Probe(props) {
      const sessionId = props.sessionId
      const usage = props.useProjection ? props.useProjection('costUsage') : undefined
      // 会话插槽按 sessionId 作为 React key 渲染：会话切换 = 组件卸载重挂。
      // 挂载时先清桥归属（新会话在产生第一条调用前投影无新值，不清会残留
      // 上一会话金额），随后由下方 effect 写入当前会话的投影值与归属 id。
      useEffect(() => {
        bridge.set({ sessionId: undefined, usage: null })
      }, [])
      // 依赖 sessionId + usage：两者任一变化都重写桥，并携带归属会话 id。
      useEffect(() => {
        bridge.set({ sessionId, usage: usage ?? null })
      }, [sessionId, usage])
      return null
    }

    // ── 悬浮徽章（shell.overlay）：订阅 bridge 渲染 ─────────────────────────

    function TideCard(props) {
      const [snap, setSnap] = useState(bridge.value)
      // 当前激活会话 id（root 插槽 standard kit）：桥数据归属校验的依据。
      const currentSessionId = props.useSessions ? props.useSessions(s => s.current) : undefined
      const usage = snap !== null && snap.sessionId === currentSessionId ? snap.usage : null
      const [now, setNow] = useState(() => Date.now())
      const [expanded, setExpanded] = useState(() => {
        try { return localStorage.getItem(EXPANDED_KEY) === '1' } catch { return false }
      })
      const [currency, setCurrency] = useState(loadCurrency)
      const [costOpen, setCostOpen] = useState(false)
      const rootRef = useRef(null)
      // 自定义位置（拖拽结果）优先于自动贴靠；用 ref 保存当前值，避免闭包读到旧值。
      const [customPos, setCustomPos] = useState(loadCustomPos)
      const posRef = useRef(customPos ?? { right: 16, bottom: 96 })
      const draggingRef = useRef(false)
      const justDraggedRef = useRef(false)
      // 展开面板的尺寸与位移（本地 fork 追加）：默认撑开到默认高宽以便滚动查看，
      // 用户拖动/缩放后写入 localStorage、刷新后保留；「复位」回到默认。
      const panelRef = useRef(null)
      const panelGeomRef = useRef(null)
      const panelBoxRef = useRef(null)
      const panelBaseRef = useRef(null)
      const chipRectRef = useRef(null)
      const [panelGeom, setPanelGeom] = useState(loadPanelGeom)
      const [panelDragging, setPanelDragging] = useState(false)
      const [panelResizing, setPanelResizing] = useState(false)
      // 面板未自定义时的自然宽度（vw 感应用户窗口宽度），用于弹出方向的可用空间判断。
      const panelNaturalWidth = Math.min(PANEL_DEFAULT_W, Math.max(PANEL_MIN_W, window.innerWidth - PANEL_EDGE * 2))

      useEffect(() => bridge.subscribe(setSnap), [])
      useEffect(() => {
        const t = setInterval(() => setNow(Date.now()), 1000)
        return () => clearInterval(t)
      }, [])
      useEffect(() => {
        if (!expanded) return
        const onDown = e => {
          if (rootRef.current !== null && !rootRef.current.contains(e.target)) setExpanded(false)
        }
        document.addEventListener('mousedown', onDown)
        return () => document.removeEventListener('mousedown', onDown)
      }, [expanded])

      const autoPos = usePlacement(rootRef, draggingRef)
      const pos = customPos ?? autoPos.pos
      // 面板自动位置（位移为 0）在渲染期计算，直接读徽章实时矩形；
      // 最终盒子 = 自动位置 + 用户位移。单一数据源，随渲染即时生效。
      const chipRect = rootRef.current !== null
        ? rootRef.current.getBoundingClientRect()
        : null
      // 徽章矩形写入 ref：缩放的处理器需要「当次渲染」的基准，闭包不能读旧值。
      chipRectRef.current = chipRect
      const panelBaseBox = chipRect !== null && !(chipRect.width === 0 && chipRect.height === 0)
        ? placePanel({
            chip: chipRect,
            naturalWidth: panelNaturalWidth,
            naturalHeight: PANEL_DEFAULT_H,
            saved: { offsetX: 0, offsetY: 0, width: panelGeom?.width, height: panelGeom?.height },
          })
        : null
      const panelOffsetX = panelGeom !== null && Number.isFinite(panelGeom.offsetX) ? panelGeom.offsetX : 0
      const panelOffsetY = panelGeom !== null && Number.isFinite(panelGeom.offsetY) ? panelGeom.offsetY : 0
      const panelBox = panelBaseBox === null
        ? null
        : { ...panelBaseBox, left: panelBaseBox.left + panelOffsetX, top: panelBaseBox.top + panelOffsetY }
      // 面板当前盒子写入 ref：拖动/缩放的处理器需要「当次渲染」的基准位置，
      // 又不能让闭包读旧值，因此以 ref 为准。
      panelBoxRef.current = panelBox
      // 自动位置（位移为 0）也存入 ref，供拖动夹紧使用。
      panelBaseRef.current = panelBaseBox
      const panelLeft = panelBox !== null && panelBox.dirX === 'left'
      const panelBelow = panelBox !== null && panelBox.dirY === 'below'
      useEffect(() => { posRef.current = pos }, [pos])
      // 面板几何写入 ref，供拖动/缩放处理器读取最新值（避免闭包读到旧 state）。
      useEffect(() => { panelGeomRef.current = panelGeom }, [panelGeom])
      const phase = nextPhase(now)
      const countdown = phase === null ? 0 : Math.max(0, phase.nextAtMs - now)
      const nextLabel = phase === null ? '下一阶段' : (phase.nextIntoPeak ? '峰期' : '谷期')
      const inPeak = phase !== null && phase.inPeak
      // 当前模型：优先取投影 view 的 model（会话正在使用的模型，实时跟随
      // request/header 更新）；无请求历史时回退 byModel 首键，再无则 flash。
      const modelKeys = usage?.byModel !== undefined ? Object.keys(usage.byModel) : []
      const activeModel = typeof usage?.model === 'string' && usage.model.length > 0 ? usage.model : (modelKeys[0] ?? 'deepseek-flash')
      const activeRule = priceRuleKeyFor(activeModel)
      const price = DISPLAY_PRICES[activeRule]
      const tier = tierForModel(activeModel, now, inPeak)
      // 分模型花费按各模型**自身**单价、以当前峰谷档位重算：每行都用当时单价，
      // 合计与该档位一致（宿主账本仍是逐事件时刻计费的权威值）。
      const byModelRows = Object.entries(usage?.byModel ?? {})
        .map(([id, bucket]) => ({
          id,
          bucket,
          key: priceRuleKeyFor(id),
          cost: costOfBuckets(bucket, tierForModel(id, now, inPeak)),
        }))
        .sort((a, b) => b.cost - a.cost)
      const bucketsCost = byModelRows.reduce((sum, row) => sum + row.cost, 0)
      // 兼容旧缓存（投影无 byModel 明细时）回退宿主账本金额。
      const costUsd = byModelRows.length > 0 ? bucketsCost : (Number(usage?.cost) || 0)
      const slotIdx = beijingSlotIndex(now)
      const weekend = isWeekendUTC(now)
      const input = Number(usage?.input) || 0
      const cache = (Number(usage?.cacheRead) || 0) + (Number(usage?.cacheWrite) || 0)
      const output = Number(usage?.output) || 0
      const reasoning = Number(usage?.reasoning) || 0

      const toggle = () => {
        const v = !expanded
        setExpanded(v)
        try { localStorage.setItem(EXPANDED_KEY, v ? '1' : '0') } catch { /* ignore */ }
      }

      // ── 拖拽：按住徽章拖动，位置持久化；点「复位」回到自动贴靠位置 ──────
      const onChipClick = () => {
        if (justDraggedRef.current) { justDraggedRef.current = false; return }
        toggle()
      }

      const resetPosition = e => {
        if (e !== undefined && e.stopPropagation !== undefined) e.stopPropagation()
        clearCustomPos()
        setCustomPos(null)
      }

      const onChipPointerDown = e => {
        if (e.button !== undefined && e.button !== 0) return
        const el = e.currentTarget
        const startX = e.clientX
        const startY = e.clientY
        const start = posRef.current
        let moved = false
        let next = start

        const apply = p => {
          next = clampPos(p, rootRef.current)
          posRef.current = next
          setCustomPos(next)
        }
        const onMove = ev => {
          const dx = ev.clientX - startX
          const dy = ev.clientY - startY
          if (!moved && Math.abs(dx) + Math.abs(dy) < DRAG_SLOP) return
          if (!moved) {
            moved = true
            draggingRef.current = true
            if (el.classList !== undefined) el.classList.add('tw-dragging')
          }
          apply({ right: start.right - dx, bottom: start.bottom - dy })
        }
        const onUp = () => {
          window.removeEventListener('pointermove', onMove)
          window.removeEventListener('pointerup', onUp)
          window.removeEventListener('pointercancel', onUp)
          if (moved) {
            draggingRef.current = false
            justDraggedRef.current = true
            if (el.classList !== undefined) el.classList.remove('tw-dragging')
            saveCustomPos(next)
          }
        }
        window.addEventListener('pointermove', onMove)
        window.addEventListener('pointerup', onUp)
        window.addEventListener('pointercancel', onUp)
        if (e.preventDefault !== undefined) e.preventDefault()
      }

      const setCurrencyPersist = next => {
        setCurrency(next)
        try { localStorage.setItem(CURRENCY_KEY, next) } catch { /* ignore */ }
      }

      // ── 展开面板：拖动移动 + 抓手缩放（本地 fork 追加）────────────────────
      // 面板位置由 placePanel 自适应（优先徽章上方，装不下翻到下方），尺寸/位移
      // 用户可改并写入 localStorage；头部双击或「复位面板」回到默认。
      const panelCustom = panelGeom !== null

      const persistPanelGeom = next => {
        // 全部为默认值（尺寸未改、位移为 0）时清掉记录，回到「紧贴徽章 + 自适应高度」。
        const isDefault = next.width === PANEL_DEFAULT_W && next.height === PANEL_DEFAULT_H
          && next.offsetX === 0 && next.offsetY === 0
        if (isDefault) {
          clearPanelGeom()
          setPanelGeom(null)
          return
        }
        savePanelGeom(next)
        setPanelGeom(next)
      }

      const resetPanel = e => {
        if (e !== undefined && e.stopPropagation !== undefined) e.stopPropagation()
        clearPanelGeom()
        setPanelGeom(null)
      }

      /** 读当前几何；未自定义时用「面板当下的实测盒子」作为起点，保证首次缩放不跳变。 */
      const currentGeom = () => {
        const geom = panelGeomRef.current
        if (geom !== null) {
          return {
            width: Number.isFinite(geom.width) ? geom.width : panelNaturalWidth,
            height: Number.isFinite(geom.height) ? geom.height : PANEL_DEFAULT_H,
            offsetX: Number.isFinite(geom.offsetX) ? geom.offsetX : 0,
            offsetY: Number.isFinite(geom.offsetY) ? geom.offsetY : 0,
          }
        }
        const el = panelRef.current
        const rect = el !== null ? el.getBoundingClientRect() : null
        return {
          width: rect !== null && rect.width > 0 ? rect.width : panelNaturalWidth,
          height: rect !== null && rect.height > 0 ? rect.height : PANEL_DEFAULT_H,
          offsetX: 0,
          offsetY: 0,
        }
      }

      /** 公共指针拖拽循环：onMove 收到相对起点的位移，onDone 在抬手时收到是否真的拖动过。 */
      const startPanelPointerDrag = (e, onMove, onDone) => {
        const startX = e.clientX
        const startY = e.clientY
        let moved = false
        const handleMove = ev => {
          const dx = ev.clientX - startX
          const dy = ev.clientY - startY
          if (!moved && Math.abs(dx) + Math.abs(dy) < DRAG_SLOP) return
          moved = true
          onMove(dx, dy)
        }
        const handleUp = () => {
          window.removeEventListener('pointermove', handleMove)
          window.removeEventListener('pointerup', handleUp)
          window.removeEventListener('pointercancel', handleUp)
          onDone(moved)
        }
        window.addEventListener('pointermove', handleMove)
        window.addEventListener('pointerup', handleUp)
        window.addEventListener('pointercancel', handleUp)
        if (e.preventDefault !== undefined) e.preventDefault()
      }

      /**
       * 头部拖动：面板随手移动。位移以「自适应弹出位置」为基准记录，
       * 因此窗口尺寸变化时仍会重新自适应，而不会把面板甩到屏幕外。
       */
      const onPanelHeaderPointerDown = e => {
        // 只响应主键；从按钮 / 缩放手柄上按下时不拖动（避免与点击、缩放冲突）。
        if (e.button !== undefined && e.button !== 0) return
        const target = e.target
        if (target !== undefined && target !== null && typeof target.closest === 'function'
          && target.closest('button, .tw-grip') !== null) return
        const panel = panelRef.current
        if (panel === null) return
        const start = currentGeom()
        let latest = start
        setPanelDragging(true)
        startPanelPointerDrag(
          e,
          (dx, dy) => {
            const wanted = { x: start.offsetX + dx, y: start.offsetY + dy }
            const clamped = clampPanelOffsetWithin(panelBaseBox, wanted, { width: start.width, height: start.height })
            latest = { ...start, offsetX: clamped.x, offsetY: clamped.y }
            setPanelGeom(latest)
          },
          moved => {
            setPanelDragging(false)
            if (moved) persistPanelGeom(latest)
            else setPanelGeom(panelGeomRef.current)
          },
        )
      }

      /**
       * 缩放：抓手**紧跟指针**，锚边按「面板贴哪一侧」决定（与 Windows 拖窗口边框同理：
       * 抓住的那条边跟指针走，对边不动）。
       *
       *   - 右开面板贴徽章左缘 → 左缘是对边（不动），抓手在右下角：
       *     右缘跟指针 → 宽度 = 原宽 + dx。
       *   - 左开面板贴徽章右缘 → 右缘是对边（不动），抓手在左下角：
       *     左缘跟指针 → 宽度 = 原宽 − dx。
       *   - 纵向一致：底边（抓手所在边）跟指针，顶边不动，向下拖变高。
       *
       * 用「目标矩形」而不是「宽度增量」来计算：面板会被视口夹紧，只累加尺寸增量
       * 会在贴边后无法跟随指针。这里先算目标边、夹紧后再反推位移。
       */
      const onPanelResizePointerDown = e => {
        if (e.button !== undefined && e.button !== 0) return
        if (e.stopPropagation !== undefined) e.stopPropagation()
        const panel = panelRef.current
        if (panel === null) return
        const start = currentGeom()
        const box = panelBoxRef.current
        if (box === null) return
        // 自动位置（位移为 0）在左开时是「徽章右缘 − 宽度」，因此**宽度会反过来
        // 影响基准 left**；若只按旧的 baseBox.left 反推位移，改宽会让面板平移两倍。
        // 这里按当前宽度重算基准，消掉这层耦合。
        const startChipRect = chipRectRef.current
        const startBaseLeft = startChipRect !== null
          ? (panelLeft ? startChipRect.right - start.width : startChipRect.left)
          : panelBaseRef.current.left
        const startBaseTop = panelBaseRef.current.top
        const startLeft = box.left
        const startTop = box.top
        const startRight = startLeft + start.width
        let latest = start
        setPanelResizing(true)
        const onMove = (dx, dy) => {
          const size = clampPanelSize(panelLeft ? start.width - dx : start.width + dx, start.height + dy)
          // 右开：左缘不动；左开：右缘不动。纵向顶边不动。
          const wantLeft = panelLeft ? startRight - size.width : startLeft
          const fitted = clampBoxToViewport(wantLeft, startTop, size)
          latest = {
            // 位移是相对「自动位置」的增量：按新宽度重算基准后再反推。
            offsetX: fitted.left - (panelLeft ? startChipRect.right - size.width : startBaseLeft),
            offsetY: fitted.top - startBaseTop,
            width: size.width,
            height: size.height,
          }
          setPanelGeom(latest)
        }
        startPanelPointerDrag(
          e,
          onMove,
          moved => {
            setPanelResizing(false)
            if (moved) persistPanelGeom(latest)
          },
        )
      }

      // 面板几何：fixed 定位 + 由 placePanel 计算出的视口坐标，任何祖先的
      // transform / overflow 都不会裁掉它。未自定义时高度自适应（只受 maxHeight
      // 约束）；一旦自定义、或正在拖抓手，就写入固定 height。
      const panelStyle = panelBox === null
        ? { visibility: 'hidden' }
        : {
            left: panelBox.left,
            top: panelBox.top,
            width: panelBox.width,
            maxHeight: panelBox.maxHeight,
            ...(panelCustom || panelResizing ? { height: panelBox.maxHeight } : {}),
          }

      return el('div', { ref: rootRef, className: 'tw-root', style: { right: pos.right, bottom: pos.bottom } },
        el('button', {
          className: 'tw-chip ' + (phase !== null && phase.inPeak ? 'peak' : 'offpeak') + (expanded ? ' open' : ''),
          onClick: onChipClick,
          onPointerDown: onChipPointerDown,
          title: '拖动可移动位置 · 点击展开 / 收起峰谷详情',
        },
          el('span', { className: 'tw-dot' }),
          el('span', { className: 'tw-phase' }, phase !== null && phase.inPeak ? '峰期' : '谷期'),
          el('span', { className: 'tw-countdown' }, '距' + nextLabel + ' ' + fmtCountdownShort(countdown)),
          el('span', { className: 'tw-sep' }),
          el('span', { className: 'tw-cost' }, fmtMoney(costUsd, currency))),
        expanded ? el('div', {
          ref: panelRef,
          className: 'tw-panel'
            + (panelLeft ? ' tw-panel-left' : '')
            + (panelBelow ? ' tw-panel-below' : '')
            + (panelCustom ? ' tw-panel-custom' : ' tw-panel-fit'),
          style: panelStyle,
        },
          // 头部：当前档位 + 倒计时；自定义尺寸/位移后整个头部即为拖动手柄
          el('div', {
            className: 'tw-panel-head' + (panelDragging ? ' tw-panel-dragging' : ''),
            onPointerDown: panelCustom ? onPanelHeaderPointerDown : undefined,
            onDoubleClick: panelCustom ? resetPanel : undefined,
            title: panelCustom ? '拖动可移动面板 · 双击复位 · 右下角可缩放' : '点击徽章展开后可拖动 / 缩放此面板',
          },
            el('span', { className: 'tw-panel-phase ' + (phase !== null && phase.inPeak ? 'peak' : 'offpeak') },
              el('span', { className: 'tw-dot' }),
              el('span', null, phase !== null && phase.inPeak ? '峰期进行中' : '谷期进行中')),
            el('span', { className: 'tw-panel-tools' },
              el('span', { className: 'tw-panel-countdown' }, '距' + nextLabel + ' ' + fmtCountdown(countdown)),
              panelCustom
                ? el('button', {
                    className: 'tw-panel-reset',
                    onClick: resetPanel,
                    title: '恢复默认尺寸并重新紧贴徽章',
                  }, '复位面板')
                : null)),
          // 峰谷时段表（北京时间）
          el('div', { className: 'tw-h' }, '官方峰谷时段（周六/周日全天谷期）'),
          el('div', { className: 'tw-slots' },
            BEIJING_SLOTS.map(function (slot, i) {
              return el('div', {
                key: slot.start + slot.end,
                className: 'tw-slot' + (i === slotIdx ? ' now' : ''),
              },
                el('span', { className: 'tw-slot-time' }, slot.start + ' – ' + slot.end),
                el('span', null,
                  i === slotIdx ? el('span', { className: 'tw-slot-now-tip' }, '现在') : null,
                  el('span', { className: 'tw-slot-tag ' + slot.phase }, slot.text)))
            })),
          weekend
            ? el('div', { className: 'tw-slot now' },
                el('span', { className: 'tw-slot-time' }, '周六 / 周日 · 00:00 – 24:00'),
                el('span', null,
                  el('span', { className: 'tw-slot-now-tip' }, '现在'),
                  el('span', { className: 'tw-slot-tag offpeak' }, '谷')))
            : null,
          // 当前模型与其档位价格
          el('div', { className: 'tw-h' }, '当前模型 · ' + price.label + '（' + (inPeak ? '峰时' : '谷时') + '）'),
          el('div', { className: 'tw-prices' },
            el('div', { className: 'tw-price-row' },
              el('span', { className: 'tw-price-label' }, '输入 · 未命中 / 缓存'),
              el('span', { className: 'tw-price-val' }, fmtMoney(tier.cacheMiss, currency) + ' / ' + fmtMoney(tier.cacheHit, currency) + ' /百万')),
            el('div', { className: 'tw-price-row' },
              el('span', { className: 'tw-price-label' }, '输出'),
              el('span', { className: 'tw-price-val' }, fmtMoney(tier.output, currency) + ' /百万'))),
          // 在售模型价格对照（官方两档单价，当前峰谷档位）
          el('div', { className: 'tw-h' }, '官方模型价格（' + (inPeak ? '峰时' : '谷时') + '档）'),
          el('div', { className: 'tw-prices' },
            RATE_RULES.map(function (rule) {
              const p = DISPLAY_PRICES[rule.key]
              const t = tierForModel(rule.label, now, inPeak)
              return el('div', { key: rule.key, className: 'tw-price-row' },
                el('span', { className: 'tw-price-label' },
                  el('span', { className: 'tw-model-tag' }, p.label),
                  rule.key === activeRule ? el('span', { className: 'tw-price-now' }, '使用中') : null),
                el('span', { className: 'tw-price-val' }, fmtMoney(t.cacheMiss, currency) + ' / ' + fmtMoney(t.cacheHit, currency) + ' / ' + fmtMoney(t.output, currency)))
            })),
          // Token 明细
          el('div', { className: 'tw-h' }, '本次会话 Token'),
          usage === undefined || (input + cache + output + reasoning) === 0
            ? el('div', { className: 'tw-empty-note' }, '会话尚无模型调用')
            : el('div', { className: 'tw-tokens' },
                el('div', { className: 'tw-token-row' },
                  el('span', { className: 'tw-token-label' }, '输入'),
                  el('span', { className: 'tw-token-val' }, fmtTokens(input))),
                el('div', { className: 'tw-token-row' },
                  el('span', { className: 'tw-token-label' }, '缓存(读+写)'),
                  el('span', { className: 'tw-token-val' }, fmtTokens(cache))),
                el('div', { className: 'tw-token-row' },
                  el('span', { className: 'tw-token-label' }, '输出'),
                  el('span', { className: 'tw-token-val' }, fmtTokens(output))),
                reasoning > 0
                  ? el('div', { className: 'tw-token-row' },
                      el('span', { className: 'tw-token-label' }, '推理'),
                      el('span', { className: 'tw-token-val' }, fmtTokens(reasoning)))
                  : null),
          // 本次会话费用（可点击展开分模型明细）
          el('div', { className: 'tw-total' + (costOpen ? ' open' : ''), onClick: () => setCostOpen(v => !v), title: '点击展开 / 收起分模型花费' },
            el('span', { className: 'tw-total-label' },
              el('span', { className: 'tw-total-arrow' }, '▶'),
              el('span', null, '本次会话费用')),
            el('span', { className: 'tw-total-val' }, fmtMoney(costUsd, currency))),
          costOpen
            ? el('div', { className: 'tw-models' },
                byModelRows.length === 0
                  ? el('div', { className: 'tw-model-row' },
                      el('span', { className: 'tw-model-label' }, '会话尚无模型调用'),
                      el('span', { className: 'tw-model-val' }, fmtMoney(0, currency)))
                  : byModelRows.map(function (row) {
                      return el('div', { key: row.id, className: 'tw-model-row' },
                        el('span', { className: 'tw-model-label' },
                          el('span', { className: 'tw-model-tag' }, DISPLAY_PRICES[row.key].label),
                          el('span', null, '输入 ' + fmtTokens(row.bucket.input) + ' · 输出 ' + fmtTokens(row.bucket.output))),
                        el('span', { className: 'tw-model-val' }, fmtMoney(row.cost, currency)))
                    }))
            : null,
          // 币种切换 + 徽章复位 + 缩放手柄
          // 抓手直接放在底部这一行的行内（而不是绝对定位到面板角落）：面板向下
          // 弹出时成长边在底部、向上弹出时在顶部，行内布置两种情况都不会压住
          // 「复位」按钮，也不会被下移的面板内容覆盖。图标方向随之翻转。
          el('div', { className: 'tw-currency' },
            el('span', null, '币种'),
            el('button', { className: 'tw-currency-btn' + (currency === 'cny' ? ' on' : ''), onClick: () => setCurrencyPersist('cny') }, '¥ 人民币'),
            el('button', { className: 'tw-currency-btn' + (currency === 'usd' ? ' on' : ''), onClick: () => setCurrencyPersist('usd') }, '$ 美元'),
            el('button', {
              className: 'tw-currency-btn',
              onClick: resetPosition,
              title: '回到输入框右侧的默认位置',
            }, '复位位置'),
            el('span', { className: 'tw-grip-spacer' }),
            // 抓手贴着「面板靠徽章的那条竖边」：右开面板 → 右下角（nw 光标），
            // 左开面板 → 左下角（ne 光标）。拖动它即拖动该边，对边固定不动。
            el('div', {
              className: 'tw-grip ' + (panelBelow ? 'tw-grip-up' : 'tw-grip-down')
                + (panelLeft ? ' tw-grip-ne' : ' tw-grip-nw')
                + (panelResizing ? ' tw-grip-active' : ''),
              onPointerDown: onPanelResizePointerDown,
              title: panelLeft
                ? '按住拖动即可缩放面板：向左拖变宽、向下拖变高（对边保持不动）'
                : '按住拖动即可缩放面板：向右拖变宽、向下拖变高（对边保持不动）',
              'aria-label': '缩放面板',
              role: 'separator',
            },
              el('svg', { width: 12, height: 12, viewBox: '0 0 12 12', 'aria-hidden': 'true' },
                el('path', { d: 'M10.5 4.5 L4.5 10.5', stroke: 'currentColor', strokeWidth: 1.6, strokeLinecap: 'round', fill: 'none' }),
                el('path', { d: 'M10.5 8.5 L8.5 10.5', stroke: 'currentColor', strokeWidth: 1.6, strokeLinecap: 'round', fill: 'none' })))))
      : null)   // end expanded
    }

    // ── 插件主体 ────────────────────────────────────────────────────────────

    // 无 RPC：仅 UI + 会话投影，无需贡献描述符。
    const CONTRIBUTION = { package: 'dsh-tidewatch', descriptors: [] }
    const inject = ['remote']

    async function apply(ctx) {
      try {
        const remote = ctx.remote
        if (remote !== undefined && typeof remote.$mount === 'function') {
          const unmount = await remote.$mount(CONTRIBUTION)
          ctx.effect(() => () => { unmount() }, 'dsh-tidewatch: contribution unmount')
        }
      } catch (error) {
        console.warn('[dsh-tidewatch] contribution mount skipped:', error)
      }
      const slots = ctx.get('slots')
      if (slots === undefined) {
        console.warn('[dsh-tidewatch] slots unavailable, tide card not mounted')
        return
      }
      // 数据探针：会话作用域插槽（提供 useProjection 席位），渲染 null。
      // 经 slots.inject 等待宿主声明，宿主声明不可用时自动卸载。
      slots.inject('conversation.composer.dock', () => slots.register(
        { name: 'conversation.composer.dock', id: 'dsh-tidewatch-probe', order: 100, inject: () => ({}) },
        Probe,
      ))
      // 悬浮徽章：根级框架悬浮层（fixed 定位，自研锚定测量，与其他插件零耦合）。
      slots.inject('shell.overlay', () => slots.register(
        { name: 'shell.overlay', id: 'dsh-tidewatch', order: 101 },
        TideCard,
      ))
    }

    exports.apply = apply
    exports.inject = inject
    // 测试钩子：供 test/panel.mjs 在最小 React 外壳里直接渲染组件。
    exports.__test__ = { TideCard, Probe, priceRuleKeyFor, tierForModel, costOfBuckets, computePanelBox, clampPanelSize }
    return module.exports
  },
})
